{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "blog": "npm run admin:dev",
    "blog-cli": "node scripts/blog.mjs",
    "content": "node scripts/build-content.mjs",
    "dev": "npm run content && concurrently -k -n content,next \"node scripts/watch-content.mjs\" \"next dev\"",
    "build": "npm run content && next build",
    "start": "next start",
    "lint": "npm run content && eslint",
    "images": "node scripts/build-images.mjs",
    "preview": "npm run db:migrate:local && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/deploy.mjs",
    "db:migrate:local": "wrangler d1 migrations apply youzilm-blog-views --local",
    "db:migrate": "wrangler d1 migrations apply youzilm-blog-views --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "admin:dev": "node scripts/admin.mjs dev",
    "admin:check": "tsc -p admin/tsconfig.json",
    "admin:build": "node scripts/admin.mjs build",
    "admin:deploy": "node scripts/admin.mjs deploy",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@waline/client": "^3.16.2",
    "katex": "^0.19.1",
    "minisearch": "^7.2.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chokidar": "^6.0.0",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "image-size": "^2.1.0",
    "jsdom": "^31.0.1",
    "mdast-util-to-string": "^4.0.0",
    "png-to-ico": "^3.0.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.6",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "wrangler": "^4.161.0"
  }
}
