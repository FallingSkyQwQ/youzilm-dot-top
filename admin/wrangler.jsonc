{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "youzilm-blog-admin",
  "main": "worker.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ratelimits": [{ "name": "ADMIN_LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": {
    "GITHUB_OWNER": "FallingSkyQwQ",
    "GITHUB_REPO": "youzilm-dot-top",
    "ADMIN_EMAIL": "charlie.0111@foxmail.com",
    "GITHUB_BRANCH": "main",
    "DEPLOY_WORKFLOW": "deploy.yml",
    "WALINE_URL": "https://waline.youzilm.top"
  }
}
