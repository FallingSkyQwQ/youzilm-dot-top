{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youzilm-blog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "VIEWS_DB",
      "database_name": "youzilm-blog-views",
      "database_id": "ebd13a2a-9a21-4061-b190-b7dc7e5c211e",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "youzilm.top",
      "custom_domain": true
    },
    {
      "pattern": "www.youzilm.top",
      "custom_domain": true
    }
  ]
}
