# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare / opennext
.open-next/
.wrangler/
.dev.vars
.dev.vars.*
cloudflare-env.d.ts

# vendored waline service
services/waline/node_modules/
services/waline/.wrangler/
services/waline/dist/

# generated by scripts/build-images.mjs (source is assets/avatar.jpeg)
# public/avatar/* is generated but kept with the site.

# local credentials and QA artifacts
.waline-admin.txt
.blog-tui.json
.blog-admin.json
admin/.build/
.build/
admin/.wrangler/
admin/.dev.vars
admin/public/fonts/
admin/public/katex.css
admin/public/favicon.png
qa-*/

# Historical binary packages
/dist/
